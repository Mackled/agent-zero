# Use the pre-built base image for Ayla Agent
# FROM ayla-agent-base:local
FROM aylaagent/ayla-agent-base:latest

# Set BRANCH to "local" if not provided
ARG BRANCH=local
ENV BRANCH=$BRANCH

# Copy filesystem files to root
COPY ./docker/run/fs/ /
# Copy current development files to git, they will only be used in "local" branch
COPY ./ /git/ayla-agent

# pre installation steps
RUN bash /ins/pre_install.sh $BRANCH

# install Ayla Agent
RUN bash /ins/install_ayla.sh $BRANCH

# install additional software
RUN bash /ins/install_additional.sh $BRANCH

# cleanup repo and install Ayla Agent without caching, this speeds up builds
ARG CACHE_DATE=none
RUN echo "cache buster $CACHE_DATE" && bash /ins/install_ayla2.sh $BRANCH

# post installation steps
RUN bash /ins/post_install.sh $BRANCH

# Expose ports
EXPOSE 22 80 9000-9009

RUN chmod +x /exe/initialize.sh /exe/run_ayla.sh /exe/run_searxng.sh /exe/run_tunnel_api.sh

# Set memory limit to 2GB
ENV DOCKER_MEMORY_LIMIT=2g

# initialize runtime and switch to supervisord
CMD ["/exe/initialize.sh", "$BRANCH"]
